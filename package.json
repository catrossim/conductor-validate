{
  "name": "conductor-validate",
  "version": "0.1.0",
  "description": "Validate Conductor workflow definitions — node wiring, node usage and data flow, offline or against a live server.",
  "keywords": [
    "conductor",
    "workflow",
    "validation",
    "lint",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catrossim/conductor-validate.git"
  },
  "homepage": "https://github.com/catrossim/conductor-validate#readme",
  "bugs": {
    "url": "https://github.com/catrossim/conductor-validate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "conductor-validate": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:viewer": "tsc -p tsconfig.viewer.json",
    "dev:viewer": "tsc -p tsconfig.viewer.json --watch",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "viewer": "./viewer/view.sh",
    "clean": "rm -rf dist",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build:viewer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:viewer": "vitest run tests/viewer-parity.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
