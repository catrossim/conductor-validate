{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 浏览器要直接 <script type="module"> 加载编译产物：
    // ESNext + Bundler 解析方式 + 纯浏览器 lib，且不引入 node 类型
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "target": "ES2022",
    "rootDir": "src",
    "outDir": "viewer/vendor",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/core.ts", "src/types.ts", "src/util.ts"]
}
